# Copy to .env and fill in every CHANGE_ME. Never commit .env.

# --- Database ---
POSTGRES_USER=ghost
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ghostkitchen
# Port on your machine (inside Docker it is always 5432).
POSTGRES_HOST_PORT=5433

# --- Google Gemini (free tier). Create a key at https://aistudio.google.com/apikey ---
# Stays on the server only; never put it in the app.
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the main model is rate limited or overloaded. Empty = no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Free-tier limits for YOUR project: check https://aistudio.google.com/rate-limit and set these to match.
GEMINI_RPM_LIMIT=5
GEMINI_FALLBACK_RPM_LIMIT=10
GEMINI_RPD_LIMIT=250

# --- Recipes: TheMealDB ---
# "1" is the free test key: fine for personal use. A public app-store release needs a supporter key
# (see https://www.themealdb.com/api.php).
MEALDB_API_KEY=1

# --- Access ---
# Optional shared token. If set, enter the same value in the app under Settings > Server.
API_TOKEN=
# Browser origins allowed to call the API from another origin (comma separated).
# Not needed when using the web app the server itself serves, or the Android app.
CORS_ORIGINS=
# Set to true when running behind a reverse proxy (Caddy, Nginx, Cloudflare Tunnel).
TRUST_PROXY=false
API_HOST_PORT=3000

# --- OCR languages (eng by default; extra packs need an image rebuild, see infra/ocr/Dockerfile) ---
OCR_LANGS=eng
