# Copy to .env and fill in every CHANGE_ME. Never commit .env.

# --- Database ---
POSTGRES_USER=ghost
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ghostkitchen
# Port on your machine (inside Docker it is always 5432).
POSTGRES_HOST_PORT=5433

# --- Google Gemini (free tier). Create a key at https://aistudio.google.com/apikey ---
# Stays on the server only; never put it in the app.
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the main model is rate limited or overloaded. Empty = no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Free-tier limits for YOUR project: check https://aistudio.google.com/rate-limit and set these to match.
GEMINI_RPM_LIMIT=5
GEMINI_FALLBACK_RPM_LIMIT=10
GEMINI_RPD_LIMIT=250

# --- Recipes: TheMealDB ---
# "1" is the free test key: fine for personal use. A public app-store release needs a supporter key
# (see https://www.themealdb.com/api.php).
MEALDB_API_KEY=1

# --- Sign-in (Clerk, free Hobby plan) ---
# With a key set, everyone signs in (Google or an emailed code) before using the app. See docs/accounts.md.
# A development key (pk_test_...) uses Clerk's shared Google credentials, so no Google Cloud setup is needed.
CLERK_PUBLISHABLE_KEY=
# Web origins allowed to use sessions, comma separated (e.g. https://kitchen.example.com). Empty = any.
CLERK_AUTHORIZED_PARTIES=

# --- Access ---
# Optional shared token, for servers without sign-in. Ignored when CLERK_PUBLISHABLE_KEY is set.
API_TOKEN=
# Browser origins allowed to call the API from another origin (comma separated).
# Not needed when using the web app the server itself serves, or the Android app.
CORS_ORIGINS=
# Set to true when running behind a reverse proxy (Caddy, Nginx, Cloudflare Tunnel).
TRUST_PROXY=false
API_HOST_PORT=3000

# --- OCR languages (eng by default; extra packs need an image rebuild, see infra/ocr/Dockerfile) ---
OCR_LANGS=eng
# service: the OCR container (Docker). local: Tesseract inside the API process, for Vercel (docs/hosting.md).
OCR_ENGINE=service

# --- Live sync: how long a device's "tell me when it changes" request waits, and how often it checks ---
HOUSEHOLD_WAIT_MS=25000
HOUSEHOLD_POLL_MS=1500
