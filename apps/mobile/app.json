{
  "expo": {
    "name": "Ghost Kitchen",
    "slug": "ghost-kitchen",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ghostkitchen",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#120e15",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.ghostkitchen.inventory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#120e15"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#120e15"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-status-bar",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#3bf1a6",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ghost Kitchen uses the camera to read grocery barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghost Kitchen uses your photos to read grocery receipts.",
          "cameraPermission": "Ghost Kitchen uses the camera to photograph grocery receipts.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ghost Kitchen listens only while you hold the microphone button, to log food you used or threw out.",
          "speechRecognitionPermission": "Ghost Kitchen turns what you say into food you used or threw out."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
