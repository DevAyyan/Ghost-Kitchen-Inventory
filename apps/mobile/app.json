{
  "expo": {
    "name": "Ghost Kitchen",
    "slug": "ghost-kitchen",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ghostkitchen",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1015",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.ghostkitchen.inventory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0e1015"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0e1015"
        }
      ],
      "expo-status-bar",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#34d399"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghost Kitchen uses your photos to read grocery receipts.",
          "cameraPermission": "Ghost Kitchen uses the camera to photograph grocery receipts.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
